using UnityEngine;
using UnityEngine.AI;

/// <summary>
/// Controla la salud, energía y estados del boss
/// </summary>
public class BossController : MonoBehaviour
{
    [Header("Health Settings")]
    [Tooltip("Vida actual del boss")]
    public int currentHealth = 1000;

    [Tooltip("Vida máxima del boss")]
    public int maxHealth = 1000;

    [Header("Energy Settings")]
    [Tooltip("Energía actual del boss")]
    public float currentEnergy = 100f;

    [Tooltip("Energía máxima del boss")]
    public float maxEnergy = 100f;

    [Tooltip("Coste de energía por disparo")]
    [Range(1f, 50f)]
    public float energyCostPerShot = 10f;

    [Tooltip("Regeneración de energía por segundo")]
    [Range(1f, 20f)]
    public float energyRegenRate = 5f;

    [Tooltip("Tiempo que permanece inconsciente cuando se queda sin energía")]
    [Range(3f, 15f)]
    public float unconsciousDuration = 5f;

    [Header("State")]
    [Tooltip("¿Está el boss inconsciente?")]
    public bool isUnconscious = false;

    [Tooltip("¿Está el boss muerto?")]
    public bool isDead = false;

    [Header("References")]
    [Tooltip("Referencia al God script para controlar disparos")]
    public God godScript;

    [Header("Animation Settings")]
    [Tooltip("Minimum speed to consider the boss is moving (for animator)")]
    public float movingThreshold = 0.1f;

    private NavMeshAgent navAgent;
    private Animator animator;
    private Rigidbody rb;
    private float unconsciousTimer = 0f;
    private bool wasKinematic = true;
    private bool isFalling = false;

    private void Awake()
    {
        navAgent = GetComponent<NavMeshAgent>();
        animator = GetComponent<Animator>();
        rb = GetComponent<Rigidbody>();

        if (godScript == null)
        {
            godScript = GetComponent<God>();
        }

        if (rb != null)
        {
            wasKinematic = rb.isKinematic;
        }

        if (animator == null)
        {
            animator = GetComponentInChildren<Animator>();
            if (animator != null)
            {
                Debug.Log("[BossController] Animator not on root; found Animator in children and assigned.");
            }
            else
            {
                Debug.LogWarning("[BossController] No Animator found on Boss (root or children). Animations won't play.");
            }
        }
    }

    private void Update()
    {
        if (isDead) return;

        // Regenerar energía si no está inconsciente
        if (!isUnconscious && currentEnergy < maxEnergy)
        {
            currentEnergy += energyRegenRate * Time.deltaTime;
            currentEnergy = Mathf.Clamp(currentEnergy, 0f, maxEnergy);
        }

        // Manejar estado inconsciente
        if (isUnconscious)
        {
            unconsciousTimer -= Time.deltaTime;

            if (unconsciousTimer <= 0f)
            {
                WakeUp();
            }
        }

        // Actualizar parámetros del Animator según la IA / física
        UpdateAnimatorParameters();
    }

    /// <summary>
    /// Update Animator parameters so the Animator can play walk/run/fall/idle states correctly.
    /// </summary>
    private void UpdateAnimatorParameters()
    {
        if (animator == null) return;

        // Dead or unconscious should not animate walk
        if (isDead)
        {
            animator.SetFloat("Speed", 0f);
            animator.SetBool("Moving", false);
            return;
        }

        if (isUnconscious)
        {
            // If unconscious, keep animator in unconscious state (trigger already set in BecomeUnconscious)
            animator.SetFloat("Speed", 0f);
            animator.SetBool("Moving", false);
            animator.SetBool("Grounded", true);
            return;
        }

        if (isFalling)
        {
            // While falling, don't update nav-based parameters
            animator.SetFloat("Speed", 0f);
            animator.SetBool("Moving", false);
            animator.SetBool("Grounded", false);
            return;
        }

        // If NavMeshAgent drives movement, use its velocity to set Speed
        if (navAgent != null && navAgent.enabled)
        {
            float speed = navAgent.velocity.magnitude;
            animator.SetFloat("Speed", speed);
            animator.SetFloat("MotionSpeed", navAgent.speed);
            animator.SetBool("Moving", speed > movingThreshold);
            animator.SetBool("Grounded", true);
        }
        else
        {
            // Fallback: no nav agent, assume idle
            animator.SetFloat("Speed", 0f);
            animator.SetFloat("MotionSpeed", 0f);
            animator.SetBool("Moving", false);
            animator.SetBool("Grounded", true);
        }
    }

    /// <summary>
    /// Llama a este método cuando el boss dispara
    /// </summary>
    public bool TryUseEnergy()
    {
        if (isDead || isUnconscious) return false;

        if (currentEnergy >= energyCostPerShot)
        {
            currentEnergy -= energyCostPerShot;
            Debug.Log($"<color=yellow>[Boss] Energy used: {energyCostPerShot}. Remaining: {currentEnergy}/{maxEnergy}</color>");
            return true;
        }
        else
        {
            // Sin energía suficiente, quedar inconsciente
            BecomeUnconscious();
            return false;
        }
    }

    /// <summary>
    /// El boss queda inconsciente
    /// </summary>
    private void BecomeUnconscious()
    {
        if (isUnconscious || isDead) return;

        isUnconscious = true;
        unconsciousTimer = unconsciousDuration;
        currentEnergy = 0f;

        Debug.Log($"<color=red>[Boss] Out of energy! Becoming unconscious for {unconsciousDuration} seconds</color>");

        // Deshabilitar IA
        if (navAgent != null)
        {
            navAgent.enabled = false;
        }

        // Deshabilitar el script de ataque
        if (godScript != null)
        {
            godScript.enabled = false;
        }

        // Activar física para que caiga al suelo
        if (rb != null)
        {
            rb.isKinematic = false;
            rb.useGravity = true;
        }

        // Animación de caída/inconsciente
        if (animator != null)
        {
            animator.SetTrigger("Unconscious");
            // O usa SetBool si tienes un estado continuo
            // animator.SetBool("IsUnconscious", true);
        }
    }

    /// <summary>
    /// El boss se despierta
    /// </summary>
    private void WakeUp()
    {
        if (!isUnconscious || isDead) return;

        isUnconscious = false;
        currentEnergy = maxEnergy; // Restaurar energía completa

        Debug.Log("<color=green>[Boss] Waking up! Energy restored!</color>");

        // Restaurar Rigidbody al estado original
        if (rb != null)
        {
            rb.isKinematic = wasKinematic;
            rb.useGravity = false;
        }

        // Reactivar IA
        if (navAgent != null)
        {
            navAgent.enabled = true;
        }

        // Reactivar el script de ataque
        if (godScript != null)
        {
            godScript.enabled = true;
        }

        // Animación de despertar
        if (animator != null)
        {
            animator.SetTrigger("WakeUp");
            // O usa SetBool
            // animator.SetBool("IsUnconscious", false);
        }
    }

    /// <summary>
    /// El boss recibe daño
    /// </summary>
    public void TakeDamage(int damageAmount)
    {
        if (isDead) return;

        currentHealth -= damageAmount;
        currentHealth = Mathf.Max(currentHealth, 0);

        Debug.Log($"<color=orange>[Boss] Took {damageAmount} damage! Health: {currentHealth}/{maxHealth}</color>");

        // Animación de daño (si no está inconsciente)
        if (!isUnconscious && animator != null)
        {
            animator.SetTrigger("Damage");
        }

        // Verificar si murió
        if (currentHealth <= 0)
        {
            Die();
        }
    }

    /// <summary>
    /// El boss muere
    /// </summary>
    private void Die()
    {
        if (isDead) return;

        isDead = true;
        isUnconscious = false;

        Debug.Log("<color=red>[Boss] Boss defeated!</color>");

        // Deshabilitar IA
        if (navAgent != null)
        {
            navAgent.enabled = false;
        }

        // Deshabilitar script de ataque
        if (godScript != null)
        {
            godScript.enabled = false;
        }

        // Animación de muerte
        if (animator != null)
        {
            animator.SetTrigger("Death");
        }

        // Desactivar colisiones de ataque
        var colliders = GetComponentsInChildren<Collider>();
        foreach (var col in colliders)
        {
            col.enabled = false;
        }

        // Opcional: Destruir después de un tiempo
        // Destroy(gameObject, 5f);
    }

    /// <summary>
    /// Obtiene el porcentaje de vida (0-1)
    /// </summary>
    public float GetHealthPercent()
    {
        return (float)currentHealth / maxHealth;
    }

    /// <summary>
    /// Obtiene el porcentaje de energía (0-1)
    /// </summary>
    public float GetEnergyPercent()
    {
        return currentEnergy / maxEnergy;
    }

    /// <summary>
    /// Inicia la animación de caída (Fall). Activa física para que el boss caiga
    /// y desactiva temporalmente la IA/NavMeshAgent. Cuando choque con el suelo,
    /// el BossController hará la transición a Idle automáticamente.
    /// </summary>
    public void StartFall()
    {
        if (isDead) return;

        Debug.Log("<color=cyan>[Boss] StartFall called - playing Fall animation and enabling physics</color>");

        // Desactivar NavMeshAgent para permitir física
        if (navAgent != null)
        {
            navAgent.enabled = false;
        }

        // Activar física para que caiga
        if (rb != null)
        {
            rb.isKinematic = false;
            rb.useGravity = true;
        }

        // Reproducir animación de caída
        if (animator != null)
        {
            // Asegurarnos de que el Animator está habilitado (puede haber sido desactivado durante la cinemática)
            if (!animator.enabled)
            {
                animator.enabled = true;
                Debug.Log("[BossController] Animator was disabled; enabling animator before playing Fall.");
            }

            // Loguear información útil del Animator (clips y parámetros) para depuración
            LogAnimatorInfo();

            // Comprobar si el estado 'Fall' existe en la capa 0
            int layer = 0;
            int fallHash = Animator.StringToHash("Fall");
            if (animator.HasState(layer, fallHash))
            {
                // Preferir CrossFade para transiciones suaves si el estado existe
                animator.CrossFade(fallHash, 0.05f, layer, 0f);
                Debug.Log("[BossController] CrossFading to 'Fall' state.");
            }
            else
            {
                // Fallback: intentar usar el trigger 'Unconscious' si existe, o reproducir clip por nombre
                Debug.LogWarning("[BossController] Animator does not contain state 'Fall' on layer 0. Trying fallback triggers/clips.");
                if (HasAnimatorParameter("Unconscious"))
                {
                    animator.SetTrigger("Unconscious");
                    Debug.Log("[BossController] Set trigger 'Unconscious' as fallback.");
                }
                else
                {
                    // Si el controlador tiene un clip llamado 'Fall', usar CrossFade por nombre
                    if (HasAnimationClipNamed("Fall"))
                    {
                        animator.CrossFade("Fall", 0.05f, layer, 0f);
                        Debug.Log("[BossController] CrossFading to clip name 'Fall' as fallback.");
                    }
                    else
                    {
                        animator.Play("Fall", layer, 0f);
                        Debug.Log("[BossController] Called animator.Play('Fall') as last-resort fallback.");
                    }
                }
            }

            animator.SetBool("Grounded", false);
            animator.SetFloat("Speed", 0f);
            animator.SetBool("Moving", false);
        }

        isFalling = true;
    }

    /// <summary>
    /// Forzar terminar la caída y poner Idle inmediatamente (útil para tests)
    /// </summary>
    public void ForceLandAndIdle()
    {
        isFalling = false;
        if (rb != null)
        {
            rb.isKinematic = wasKinematic;
            rb.useGravity = false;
        }

        if (navAgent != null)
        {
            navAgent.enabled = true;
        }

        if (animator != null)
        {
            animator.Play("Idle", 0, 0f);
            animator.SetBool("Grounded", true);
            animator.SetFloat("Speed", 0f);
            animator.SetBool("Moving", false);
        }
    }

    /// <summary>
    /// Verifica si el boss está muerto
    /// </summary>
    public bool IsDead()
    {
        return isDead;
    }

    /// <summary>
    /// Verifica si el boss está inconsciente
    /// </summary>
    public bool IsUnconscious()
    {
        return isUnconscious;
    }

    private void OnCollisionEnter(Collision collision)
    {
        // Cuando el boss inconsciente colisiona con el suelo
        if (isUnconscious && IsGroundCollision(collision))
        {
            Debug.Log("<color=yellow>[Boss] Hit the ground while unconscious</color>");

            // Opcional: Efecto de impacto
            // PlayImpactEffect(collision.contacts[0].point);
        }

        // Cuando el boss está en estado de caída y toca el suelo, pasar a Idle
        if (isFalling && IsGroundCollision(collision))
        {
            isFalling = false;
            Debug.Log("<color=green>[Boss] Landed on ground after fall - switching to Idle</color>");

            // Restaurar física al estado original
            if (rb != null)
            {
                rb.isKinematic = wasKinematic;
                rb.useGravity = false;
            }

            // Reactivar NavMeshAgent
            if (navAgent != null)
            {
                navAgent.enabled = true;
            }

            // Forzar animación Idle (preferir CrossFade/Play si existe)
            if (animator != null)
            {
                int layer = 0;
                int idleHash = Animator.StringToHash("Idle");
                if (animator.HasState(layer, idleHash))
                {
                    animator.CrossFade(idleHash, 0.05f, layer, 0f);
                }
                else if (HasAnimationClipNamed("Idle"))
                {
                    animator.CrossFade("Idle", 0.05f, layer, 0f);
                }
                else
                {
                    animator.Play("Idle", layer, 0f);
                }

                animator.SetBool("Grounded", true);
                animator.SetFloat("Speed", 0f);
                animator.SetBool("Moving", false);
            }
        }
    }

    /// <summary>
    /// Determina si una colisión debería considerarse como tocar el suelo.
    /// Usa la etiqueta 'Ground' si existe, o comprueba la normal de contacto (y) como fallback.
    /// </summary>
    private bool IsGroundCollision(Collision collision)
    {
        if (collision == null) return false;

        // Primero, si el objeto tiene la etiqueta Ground, respetarla
        if (collision.gameObject.CompareTag("Ground")) return true;

        // Si no, examinar los puntos de contacto: si alguna normal apunta mayormente hacia arriba, considerarlo suelo
        foreach (var contact in collision.contacts)
        {
            if (contact.normal.y > 0.6f)
            {
                return true;
            }
        }

        return false;
    }

    private void LogAnimatorInfo()
    {
        if (animator == null)
        {
            Debug.LogWarning("[BossController] LogAnimatorInfo: animator is null.");
            return;
        }

        var rac = animator.runtimeAnimatorController;
        if (rac == null)
        {
            Debug.LogWarning("[BossController] LogAnimatorInfo: runtimeAnimatorController is null.");
            return;
        }

        var clips = rac.animationClips;
        string clipNames = clips == null ? "(none)" : string.Join(", ", System.Array.ConvertAll(clips, c => c.name));
        Debug.Log($"[BossController] Animator clips: {clipNames}");

        var paramNames = animator.parameters == null ? "(none)" : string.Join(", ", System.Array.ConvertAll(animator.parameters, p => p.name + ":" + p.type));
        Debug.Log($"[BossController] Animator parameters: {paramNames}");
    }

    private bool HasAnimationClipNamed(string name)
    {
        if (animator == null) return false;
        var rac = animator.runtimeAnimatorController;
        if (rac == null || rac.animationClips == null) return false;
        foreach (var c in rac.animationClips)
        {
            if (c != null && c.name == name) return true;
        }
        return false;
    }

    /// <summary>
    /// Utility: comprueba si el Animator tiene un parámetro con el nombre dado
    /// </summary>
    private bool HasAnimatorParameter(string paramName)
    {
        if (animator == null) return false;
        foreach (var p in animator.parameters)
        {
            if (p.name == paramName) return true;
        }
        return false;
    }

    // Gizmos para debug
    private void OnDrawGizmosSelected()
    {
        // Mostrar estado de energía
        Gizmos.color = isUnconscious ? Color.red : Color.green;
        Vector3 pos = transform.position + Vector3.up * 3f;
        Gizmos.DrawWireSphere(pos, 0.5f);
    }
}
